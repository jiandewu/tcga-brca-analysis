╰─$ paste <(cut -f6 ../TCGA-A7-A0D9-01A-31D-A10P.txt | awk '{split($1, valueArray,";");print valueArray[1]}') <(awk -F $'\t' 'BEGIN{OFS = FS}{_[FNR]=(_[FNR] OFS $2)}END{for (i=1; i<=FNR; i++) {sub(/^\t/,"",_[i]); print _[i]}}' **/TCGA-*.txt) | awk -F $'\t' '(gsub(/NA/,"0")<8 && $1 !="."){print}' | body sort -u -k 1,1 | sed -e '1s/-...-...-....\.txt\>//g' > ./combin.txt

╰─$ paste <(cut -f1 ../TCGA-A7-A0D9-01A-31D-A10P.txt) <(awk -F $'\t' 'BEGIN{OFS = FS}{_[FNR]=(_[FNR] OFS $2)}END{for (i=1; i<=FNR; i++) {sub(/^\t/,"",_[i]); print _[i]}}' **/TCGA-*.txt) | awk -F $'\t' '(gsub(/NA/,"0")<8 && $1 !="."){print}' | body sort -u -k 1,1 | sed -e '1s/-...-...-....\.txt\>//g' > ./combin_prob.txt


