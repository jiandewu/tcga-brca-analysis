#!/bin/bash
grep -wFf <(cut -f1 all_intersection.txt | tail -n+2 | sed -e '1iHugo_Symbol') /home/jiande/prjs/BreastTumor/combi_gene_exp/Analysis/trip/Variant_Type.txt | awk -F $'\t' '(NR==1){split($0,a,"\t");next};{s2=""; for(i=2;i<=NF;i++) if ($i!="") s2=s2 (s2?";":"") a[i]; print $1,s2}' OFS='\t' | 
while IFS='' read -r line || [[ -n "$line" ]]; do
    gene=${line%%TCGA*01}
    files=${line#$gene}
    for i in $(echo $files | tr ";" "\n"); do
        grep $gene /home/jiande/prjs/BreastTumor/gdac.broadinstitute.org_BRCA.Mutation_Packager_Oncotated_Calls.Level_3.2016012800.0.0/trip/${i}.hg19.oncotator.hugo_entrez_remapped.maf.txt | cut -f1,5-7
    done
done | 
uniq | sed -e '1igene\tChromosome\tStart\tEnd' > all_intersection_mut_position.txt

join -1 1 -2 1 -t $'\t' <(grep -wFf <(cut -f1 all_intersection.txt) normal_TNBC_p_gene.txt | cut -f1,2 | body sort -k1,1) /home/jiande/prjs/BreastTumor/methylation/TCGA-A7-A0D9-01A-31D-A10P.txt | cut -f1,2,4-6 | body sort -k2,2 > all_intersection_methy_position.txt

╭─jiande@BIG-L08 ~/prjs/BreastTumor/HicksRaw  
╰─$ libreoffice --headless --convert-to csv "HICKS_TARUN_PCA-P1_GWAS-GENES_UPD2018-SNPS-Copy of GWAS-TABLE_SA_PROSTATE_SNP_GENES.xlsx" ./

╭─jiande@BIG-L08 ~/prjs/BreastTumor/methylation/limma/result  
╰─$ grep -wFf <(cut -f1 all_intersection.txt) <(tail -n+3 /home/jiande/prjs/BreastTumor/HicksRaw/HICKS_TARUN_PCA-P1_GWAS-GENES_UPD2018-SNPS-Copy\ of\ GWAS-TABLE_SA_PROSTATE_SNP_GENES.csv |  cut -d ',' -f1,2) | 
while IFS='' read -r line || [[ -n "$line" ]]; do
    gene=${line%%,rs*}
    SNP=${line#$gene,}
    temp=$(wget -q -O- https://www.ncbi.nlm.nih.gov/snp/$SNP | grep -A 1 '<td>GRCh37.p13' | tr '\n' ' ')
    chr=${temp%%</td>*}
    chr=chr${chr#*chr }
    pos=${temp##*g\.}
    pos=${pos%%[A-Z]*}
    echo $gene"\t"$SNP"\t"$chr"\t"$pos
done > all_intersection_germline_position.txt
