#chr:    chr7 
#pos: 98021211A>G</td>
#pos: 98021211


cat <(cut -f2-4 all_intersection_methy_position.txt | awk '{if (NR==1) print "Mutation\t" $0;else print "Methylation\t" $0;}') <(cut -f1-3 all_intersection_mut_position.txt | tail -n+2 | awk '{$2="chr" $2;print "Somatic",$1,$2,$3}' OFS='\t') <(awk '{print "Germline",$1,$3,$4}' OFS='\t' all_intersection_germline_position.txt) | body sort -k2,2 | awk -F $'\t' -f /home/jiande/Clouds/Dropbox/Documents/Gitlab/LSUHSC/WorkCodes/bin/Swap2Columns.awk i=1 j=2 > all_intersection_position.txt

join -1 1 -2 3 -t $'\t' <(tail -n+2 all_intersection_position.txt) <(cut -f3-5 /home/jiande/prjs/RefGene/GRCh37_gene-symbols.txt | tail -n+2 | sort -k3,3) | sed -e '1iGene\tMutation\tChromosome\tPosition\tStart\tEnd' > all_intersection_position_geneloc.txt

