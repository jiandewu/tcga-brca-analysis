## Normal samples
awk -F $'\t' 'BEGIN{OFS = FS}{if(FNR==NR){a[$1]=$1};gsub(/^.*\//,"",FILENAME);gsub(/\.mirbase.*$/,"",FILENAME);if(FNR==1) a[$1]=(a[$1] OFS FILENAME); else a[$1]=(a[$1] OFS $3);}END{for (i in a) {print a[i]}}' $(find /home/jiande/prjs/BreastTumor/miRNA/Normal162/miRNA -name "*.quantification.txt") | sort -k1,1r |body sort -k1,1 > Normal104.miRNA.txt

