join -1 1 -2 1 -t $'\t' <(body sort -k 1,1 </home/jiande/prjs/RefGene/GRCh37_gene-symbols.txt) <(awk -F '\t' 'BEGIN{OFS="\t";} {sub(/\..+$/, "", $1)}1' tnbc_tumor.ctrl.Pvalue.txt | sed -e '1s/^/Gene stable ID\t/' | body sort -k 1,1) | cut -f1,5,7- > RNAseq_p_gene.txt

awk -F $'\t' '(($3>=2||$3<=-2)&&$7<0.001){print}' RNAseq_p_gene.txt | cut -f2,3 | awk -F $'\t' '
function abs(v) {return v < 0 ? -v : v}
{if (abs(_[$1])<abs($2)) _[$1]=$2;} END{for(v in _) print v,_[v]}
' OFS='\t' | sort -k1,1 | sed -e '1iGene\tRNAseq logFC' > RNAseq_genes_FC.txt

