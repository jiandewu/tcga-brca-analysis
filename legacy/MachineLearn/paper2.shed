cat <(head -909 /home/jiande/Clouds/VWin7/Flash/Clouds/OneDrive/LSUHSC/Flash/Prjs/BreastCancer/GWAS_1.txt | tail -n+4 | cut -f 11,15,16,23,29 | awk -F $'\t' '{
    gsub(/"/,"");gene=$2";"$3;
    n=split(gene,a,",|;| - ");
    delete genes;
    for(i=1;i<=n;i++)
    {
        gsub(" ","",a[i]);
        if(a[i]!="")genes[a[i]]=a[i]
    }
    for(g in genes)
    {
        if(g!="NR"&&g!="intergenic"&&g!="Intergenic")print g,$1,tolower($4),$5,"1"
    }
}' OFS='\t') <(tail -n+4 /home/jiande/Clouds/VWin7/Flash/Clouds/OneDrive/LSUHSC/Flash/Prjs/BreastCancer/GWAS_2.txt | cut -f 1-4 | awk -F $'\t' '{
    gsub(/"/,"");n=split($1,a,",|;| - ");
    for(i=1;i<=n;i++)
    {
        gsub(" ","",a[i]);
        print a[i],$2,tolower($3),$4,"2"
    }
}' OFS='\t') | sort -k1,1 | awk -F $'\t' '{
    if(NR==1)
    {
        agene=$1;apos[$2]=$2;asnp[$3]=$3;apmin=$4;apmax=$4;asheet[$5]=$5
    }
    else
    {
        if($1==agene)
        {
            apos[$2]=$2;asnp[$3]=$3;if($4<apmin)apmin=$4;if($4>apmax)apmax=$4;asheet[$5]=$5
        }
        else
        {
            pos="";snp="";sheet="";event=0;
            for(i in apos)pos=pos==""?i:pos";"i;
            for(i in asnp){snp=snp==""?i:snp";"i;event=event+1;}
            for(i in asheet)sheet=sheet==""?i:sheet";"i;
            delete apos;
            delete asnp;
            delete asheet;
            print agene,pos,snp,event,apmin,apmax,sheet;
            agene=$1;apos[$2]=$2;asnp[$3]=$3;apmin=$4;apmax=$4;asheet[$5]=$5;
        }
    }
}' OFS='\t' | sed -e '1iGene name\tRegion\tSNP_ID\tGWAS Event\tGWAS P-value\tP-val.max\tsheet' > gwas.event.info.txt



