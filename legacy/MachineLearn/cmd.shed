sed -n '5p;13p;21,22p;24p;29p;575p;1160p;1359p;1478p;1480p;1481q' /home/jiande/prjs/BreastTumor/raw_data/gdac.broadinstitute.org_BRCA.Merge_Clinical.Level_1.2016012800.0.0/BRCA.clin.merged.txt | awk -f $gitbin/Swap2Rows.awk first=7 second=8 > 00.BRCA.clin.merged.cut.txt

awk -f $gitbin/Swap2Rows.awk first=1 second=5 00.BRCA.clin.merged.cut.txt | awk -f $gitbin/Swap2Rows.awk first=2 second=6 | awk -f $gitbin/Swap2Rows.awk first=3 second=7 | awk -F $'\t' -f $gitbin/ExtractColumnsbyKey.awk key="negative" | tail -n+2 | awk -F $'\t' -f $gitbin/ExtractColumnsbyKey.awk key="negative" | tail -n+2 | awk -F $'\t' -f $gitbin/ExtractColumnsbyKey.awk key="negative" | tail -n+2 > 01.TNBC.clin.list.txt

awk -f $gitbin/Swap2Rows.awk first=1 second=5 00.BRCA.clin.merged.cut.txt | awk -F $'\t' -f $gitbin/ExtractColumnsbyKey.awk key="positive" | tail -n+2 > 01.ERPBC.clin.list.txt

join -1 2 -2 1 <(grep -wFf <(cut -f2- 01.TNBC.clin.list.txt | head -1 | tr '\t' '\n') <(grep -E 'file_name|case_id' /home/jiande/prjs/BreastTumor/raw_data/files.2018-11-09.json | awk -F':' '{print $2}' | sed -e 's/"//g;s/,//' | sed -e 'N;s/\n/\t/') | sort -k2,2) <(cut -f2- 01.TNBC.clin.list.txt | sed -n '1p;4p' | awk -F $'\t' -f $gitbin/Transpose.awk OFS='\t' | sort -k1,1) | tr ' ' '\t' > 02.TNBC.patient.uuid.file.name.barcode.txt

join -1 2 -2 2 <(grep -wFf <(cut -f2- 01.ERPBC.clin.list.txt | head -3 | tail -1 | tr '\t' '\n') <(grep -E 'file_name|case_id' /home/jiande/prjs/BreastTumor/raw_data/files.2018-11-09.json | awk -F':' '{print $2}' | sed -e 's/"//g;s/,//' | sed -e 'N;s/\n/\t/') | sort -k2,2) <(cut -f2- 01.ERPBC.clin.list.txt | sed -n '2,3p' | awk -F $'\t' -f $gitbin/Transpose.awk OFS='\t' | sort -k2,2) | tr ' ' '\t' > 02.ERPBC.patient.uuid.file.name.barcode.txt

mkdir tmp

cut -f2,3 02.TNBC.patient.uuid.file.name.barcode.txt |\
while read LINE 
do
  FILE=${LINE%.gz*}
  ID=${LINE##*tcga-}
  find /home/jiande/prjs/BreastTumor/raw_data/RNAseq_counts/Tumor -name "${FILE}.gz" -exec gunzip -c '{}'  > tmp/${FILE}.txt \;
  sed -i -e "60484,60488d" -e "1iGene stable ID\t$ID" tmp/${FILE}.txt
done

find tmp -size 0 -exec rm {} \;

awk -F $'\t' 'BEGIN{OFS = FS}{if (FNR==NR) {_[FNR]=$1};_[FNR]=(_[FNR] OFS $2)}END{for (i=1; i<=FNR; i++) {print _[i]}}' tmp/*.htseq.counts.txt > 03.TNBC.tumor.counts.txt

rm -f tmp/*

cut -f2,3 02.TNBC.patient.uuid.file.name.barcode.txt |\
while read LINE 
do
  FILE=${LINE%.gz*}
  ID=${LINE##*tcga-}
  find /home/jiande/prjs/BreastTumor/raw_data/RNAseq_counts/Normal -name "${FILE}.gz" -exec gunzip -c '{}'  > tmp/${FILE}.txt \;
  sed -i -e "60484,60488d" -e "1iGene stable ID\t$ID" tmp/${FILE}.txt
done

find tmp -size 0 -exec rm {} \;

awk -F $'\t' 'BEGIN{OFS = FS}{if (FNR==NR) {_[FNR]=$1};_[FNR]=(_[FNR] OFS $2)}END{for (i=1; i<=FNR; i++) {print _[i]}}' tmp/*.htseq.counts.txt > 03.TNBC.normal.counts.txt

rm -f tmp/*

