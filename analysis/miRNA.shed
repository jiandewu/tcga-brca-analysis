awk -F $'\t' 'BEGIN{OFS = FS}{if(FNR==NR){a[$1]=$1};gsub(/^.*\//,"",FILENAME);gsub(/\.mirbase.*$/,"",FILENAME);if(FNR==1) a[$1]=(a[$1] OFS FILENAME); else a[$1]=(a[$1] OFS $3);}END{for (i in a) {print a[i]}}' $(awk 'BEGIN{FS="\t";OFS="\t"}(NR>1){if($4=="Solid Tissue Normal")print "/home/jiande/prjs/RAWDATA/BreastCancer/DATA/"$2"/"$3}' miRNA_caseID.txt) | sort -k1,1r |body sort -t '-' -k2,2 -k3,3n > Normal104.miRNA.txt

awk -F $'\t' 'BEGIN{OFS = FS}{if(FNR==NR){a[$1]=$1};gsub(/^.*\//,"",FILENAME);gsub(/\.mirbase.*$/,"",FILENAME);if(FNR==1) a[$1]=(a[$1] OFS FILENAME); else a[$1]=(a[$1] OFS $3);}END{for (i in a) {print a[i]}}' $(awk 'BEGIN{FS="\t";OFS="\t"}(NR>1){if($4=="Primary Tumor"&&$5=="Yes")print "/home/jiande/prjs/RAWDATA/BreastCancer/DATA/"$2"/"$3}' miRNA_caseID.txt) | sort -k1,1r |body sort -t '-' -k2,2 -k3,3n > TNBC114.miRNA.txt


awk '($6<0.05){print $1}' /home/jiande/prjs/Analysis/BreastCancer/miRNA/edgeR_miRNA_DE.tsv | wc -l

awk '($6<0.05&&($2>1||$2<-1)){print $1}' /home/jiande/prjs/Analysis/BreastCancer/miRNA/edgeR_miRNA_DE.tsv | wc -l

join -1 1 -2 1 -t $'\t' <(awk 'BEGIN{print "miRNAs"}($6<0.05&&($2>1||$2<-1)){print $1}' /home/jiande/prjs/Analysis/BreastCancer/miRNA/edgeR_miRNA_DE.tsv | body sort) <(body sort -k1,1 </home/jiande/prjs/Analysis/BreastCancer/miRNA/miRNA_Normalized_logcpm.tsv) >/home/jiande/prjs/Analysis/BreastCancer/miRNA/miRNA_Normalized_logcpm_p0.05logfc1.tsv

join -1 1 -2 1 -t $'\t' <(awk 'BEGIN{print "miRNAs"}($6<0.05&&($2>2||$2<-2)){print $1}' /home/jiande/prjs/Analysis/BreastCancer/miRNA/edgeR_miRNA_DE.tsv | body sort) <(body sort -k1,1 </home/jiande/prjs/Analysis/BreastCancer/miRNA/miRNA_Normalized_logcpm.tsv) >/home/jiande/prjs/Analysis/BreastCancer/miRNA/miRNA_Normalized_logcpm_p0.05logfc2.tsv