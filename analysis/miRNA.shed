join -1 1 -2 1 -t $'\t' -o '0,1.2,1.3,1.4,2.5,2.3,2.4' <(grep "mirnas" /home/jiande/prjs/RAWDATA/BreastCancer/clean/caseID_foldID_filename_more.txt) <(sort -k1,1 /home/jiande/prjs/RAWDATA/BreastCancer/clean/caseID_clinical.txt) | sed -e '1icaseID\tfileID\tfileName\ttype\ttnbc\trace\tethnicity' > miRNA_caseID.txt

