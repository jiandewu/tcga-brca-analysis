awk -F $'\t' 'BEGIN{OFS = FS;header="ID"}{if(FNR==1){gsub(/^.*TCGA-/,"",FILENAME);gsub(/\.gdc_hg38.*$/,"",FILENAME);header=(header OFS FILENAME)}else {if(FNR==NR)a[$1]=$1; a[$1]=(a[$1] OFS $2)}}END{print header;for (i in a)print a[i]}' $(awk 'BEGIN{FS="\t";OFS="\t"}(NR>1&&$4=="Primary Tumor"&&$5=="No"){print "/home/jiande/prjs/RAWDATA/BreastCancer/DATA/"$2"/"$3}' Methylation.FPKM_caseID.txt) |body sort -k1,1 > Methylation.nonTNBC597.604.txt



join -1 1 -2 1 -t $'\t' <(tail -n+2 /home/jiande/prjs/Analysis/BreastCancer/Methylation/probe_Symbol.txt | sort -k1,1 | sed -e '1iid\tgene_name') <(body sort -k1,1 <limma.DE.TNBC.Normal.txt) | body sort -k10,10g > limma.DE.TNBC.Normal.gene.txt

join -1 1 -2 1 -t $'\t' <(tail -n+2 /home/jiande/prjs/Analysis/BreastCancer/Methylation/probe_Symbol.txt | sort -k1,1 | sed -e '1iid\tgene_name') <(body sort -k1,1 <limma.DE.nonTNBC.Normal.txt) | body sort -k10,10g > limma.DE.nonTNBC.Normal.gene.txt

